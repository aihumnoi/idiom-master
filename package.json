{
  "name": "idiom-master",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "IdiomMaster — จำสำนวนอังกฤษ 500 คำด้วย SRS FSRS-lite, ทนทานระดับ production",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "cap:build": "vite build && npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
